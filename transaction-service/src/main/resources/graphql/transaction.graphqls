type Transaction {
  id: ID!
  accountId: ID!
  amount: Float!
  currency: String
  merchantCategory: String
  country: String
  createdAt: String
  type: String
}
type Query {
  transactions(accountId: ID): [Transaction!]!
}
type Mutation {
  createTransaction(
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
  ): Transaction!
  transfer(
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
  ): [Transaction!]!
}
